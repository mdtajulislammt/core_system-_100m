# Database Connection (PostgreSQL 16 with logical replication)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orders_db?schema=public&connection_limit=50&pool_timeout=10"

# Elasticsearch / OpenSearch
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""
ELASTICSEARCH_API_KEY=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Kafka
KAFKA_BROKERS="localhost:9092"

# Application
PORT=3000
NODE_ENV="production"
